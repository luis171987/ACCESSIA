<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Accessia.Windows</AssemblyName>
    <Authors>GENAI INDUSTRIES; Luis Carlos Moreno Jiménez</Authors>
    <Company>GENAI INDUSTRIES</Company>
    <Description>ACCESSIA — Navegador Inteligente de Accesibilidad Universal</Description>
    <Copyright>Copyright © 2026 GENAI INDUSTRIES — Luis Carlos Moreno Jiménez</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../shared/THIRD_PARTY_NOTICES.txt" Link="assets/THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../shared/licenses/*" Link="assets/licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <Content Include="../../shared/agent-tools.json" Link="assets/agent-tools.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../shared/agent-prompt.txt" Link="assets/agent-prompt.txt" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <Content Include="../../shared/accessia.js" Link="assets/accessia.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
